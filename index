.stage{background:radial-gradient(circle,#fff4dc22,#0000 70%);text-align:center;padding:10px 0}
.stage h2{color:var(--gold);margin:4px 0}
.hint{opacity:.85;font-size:.95rem;animation:pulse 1.6s infinite}
@keyframes pulse{50%{opacity:.4}}
.char{width:230px;max-width:70%;cursor:pointer;animation:bob 2.4s ease-in-out infinite}
.fam{display:flex;justify-content:center;cursor:pointer}
.fam svg{width:24%;animation:bob 2.4s ease-in-out infinite}
.fam svg:nth-child(2n){animation-delay:.6s}
@keyframes bob{50%{transform:translateY(-8px)}}
.eye{animation:blink 4s infinite;transform-origin:center;transform-box:fill-box}
@keyframes blink{0%,94%,100%{transform:scaleY(1)}97%{transform:scaleY(.1)}}
.wave{animation:wave 1s ease-in-out infinite alternate;transform-origin:150px 170px}
@keyframes wave{from{transform:rotate(-14deg)}to{transform:rotate(18deg)}}
#modal{position:fixed;inset:0;background:#000a;display:none;align-items:center;justify-content:center;z-index:10;padding:20px}
.card{background:linear-gradient(var(--cream),#ffe3a8);color:var(--dk);border:4px double var(--red);border-radius:22px;max-width:420px;width:100%;padding:26px 22px;text-align:center;position:relative;animation:pop .5s cubic-bezier(.2,1.4,.4,1)}
