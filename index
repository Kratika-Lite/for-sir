.fin{background:var(--gold);color:var(--dk);border-radius:14px;padding:10px;margin:6px 0;text-align:center;font-weight:bold}
.cd{text-align:center;font-weight:bold;color:var(--gold);margin:0 0 8px}
#mus{position:fixed;top:18px;right:20px;z-index:6;background:#0006;border:1px solid var(--gold);border-radius:50%;width:38px;height:38px;font-size:1.1rem;color:#fff}
.thali{display:flex;justify-content:center;gap:26px;font-size:3.6rem;margin:16px 0}
.thali span{display:inline-block;text-align:center;line-height:1}
.lit{animation:flick 1.2s infinite alternate;filter:drop-shadow(0 0 16px var(--gold))}
.ring{animation:rg .6s}
@keyframes rg{25%{transform:rotate(25deg)}75%{transform:rotate(-25deg)}}
.sv{display:none}.dl .sv{display:inline-block}
.track{position:relative;height:34px;background:#0005;border-radius:17px;margin:14px auto;max-width:360px;border:2px solid var(--gold)}
.zone{position:absolute;left:38%;width:24%;top:0;bottom:0;background:#4caf5099}
.mk{position:absolute;top:2px;width:26px;height:26px;margin-left:-13px;border-radius:50%;background:var(--gold);left:50%;box-shadow:0 0 10px var(--gold)}
canvas{touch-action:none;width:100%;max-width:320px;border-radius:50%;border:4px solid var(--gold)}
.pal i{display:inline-block;width:30px;height:30px;border-radius:50%;margin:8px 4px 0;border:2px solid #fff;cursor:pointer}
.stage .row button{background:var(--gold);color:var(--dk)}
.pet{position:fixed;top:-30px;font-size:1.4rem;animation:fall linear forwards;z-index:11;pointer-events:none}
@keyframes fall{to{transform:translateY(110vh) rotate(360deg)}}
.tg{display:grid;grid-template-columns:1fr 1fr;gap:10px;text-align:left;margin-top:8px}
.tc{display:flex;align-items:center;gap:10px;background:#0003;border:2px solid transparent;border-radius:14px;padding:10px;cursor:pointer}
.tc.on{border-color:var(--gold);background:#fff2}
.tc i,.tc b{flex:0 0 38px;height:38px;border-radius:50%;border:2px solid var(--gold);text-align:center;font-style:normal}
.tc b{border:0;font-size:1.8rem;line-height:38px}
.tc small{opacity:.8}
.tc.au{grid-column:1/-1}

