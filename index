button{font-family:inherit;cursor:pointer}
.btn{background:linear-gradient(var(--gold),var(--org));border:0;color:var(--dk);font-weight:bold;font-size:1.1rem;padding:12px 30px;border-radius:30px;box-shadow:0 4px 14px #0006}
#app{display:none;padding:22px 16px 40px;max-width:560px;margin:auto}
.top{display:flex;justify-content:center;gap:6px;margin-bottom:12px}
.top button{background:#0003;border:1px solid var(--gold);color:var(--cream);padding:6px 12px;border-radius:16px}
.top button.on{background:var(--gold);color:var(--dk);font-weight:bold}
.tabs{display:flex;gap:6px;overflow-x:auto;padding:4px 0 12px}
.tabs button{flex:0 0 auto;background:#fff2;border:1px solid #f7b73388;color:var(--cream);padding:8px 14px;border-radius:14px;font-size:1rem}
