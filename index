*{box-sizing:border-box}
body{margin:0;min-height:100vh;font-family:Georgia,'Noto Serif Devanagari',serif;background:radial-gradient(circle at 50% 0,var(--b1) 0,var(--b2) 45%,var(--b3) 100%);color:var(--cream);overflow-x:hidden}
.border{position:fixed;inset:0;pointer-events:none;border:10px solid transparent;border-image:repeating-linear-gradient(45deg,var(--gold) 0 10px,var(--org) 10px 20px,var(--red) 20px 30px) 10;z-index:5}
#intro{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:30px}
h1{font-size:clamp(2rem,8vw,3.4rem);margin:8px 0;color:var(--gold);text-shadow:0 3px 0 var(--dk)}
.sub{opacity:.9;margin:0 0 24px}
