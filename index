.card p:nth-of-type(1){animation-delay:.3s}.card p:nth-of-type(2){animation-delay:.9s}.card p:nth-of-type(3){animation-delay:1.5s}
@keyframes up{from{transform:translateY(14px)}to{opacity:1;transform:none}}
.from{font-style:italic;color:var(--org)}
.x{position:absolute;top:8px;right:12px;background:var(--red);color:#fff;border:0;border-radius:50%;width:34px;height:34px;font-size:1.1rem}
