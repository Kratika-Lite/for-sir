.prog i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--gold),var(--org));transition:width .6s}
.pt{text-align:center;font-size:.9rem;margin:0 0 6px;opacity:.9}
#art{position:relative;display:block}
.badge{position:absolute;right:14%;top:6%;font-size:2.2rem;animation:swing 1.6s ease-in-out infinite;transform-origin:top center;filter:drop-shadow(0 0 8px #000a)}
@keyframes swing{50%{transform:rotate(14deg)}}
.lockbig{font-size:4.2rem;display:block;animation:swing 1.8s ease-in-out infinite}
.unl .lockbig{animation:none;transform:scale(1.35);transition:.4s}
.shake{animation:shake .45s}
@keyframes shake{20%,60%{transform:translateX(-12px)}40%,80%{transform:translateX(12px)}}
.q{font-weight:bold;margin:8px 0;font-size:1.1rem}
.card input{width:100%;padding:11px;border-radius:12px;border:2px solid var(--red);font:inherit;font-size:1.1rem;text-align:center;background:#fff;color:var(--dk)}
.row{display:flex;gap:8px;justify-content:center;margin-top:12px}
.row button{border:0;border-radius:20px;padding:9px 18px;font-weight:bold;background:var(--red);color:#fff}
