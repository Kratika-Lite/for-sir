<style>
:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);--red:#8e0f2a;--gold:#f7b733;--org:#f26b1d;--cream:#fff4dc;--b1:#c2185b;--b2:#8e0f2a;--b3:#4a0618;--dk:#4a0618}
